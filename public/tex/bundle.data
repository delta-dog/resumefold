}
\def\MT@prot@check@o@#1[#2]#3{%
  \MT@ifempty{#2}
    {\MT@toks\expandafter{\the\MT@toks#1{#3}}}
    {\MT@toks\expandafter{\the\MT@toks#1[#2]{#3}}}%
  \MT@prot@get@firstgroup
}
\def\MT@prot@check@T{%
