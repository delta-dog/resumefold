    }\Hy@temp@A
    \ifin@
      \ltx@IfUndefined{theH#2}{%
        \expandafter\ltx@LocalAppendToMacro\expandafter#1%
        \expandafter{%
          \expandafter\@arabic\csname c@#2\endcsname.%
        }%
      }{%
        \expandafter\ltx@LocalAppendToMacro\expandafter#1%
