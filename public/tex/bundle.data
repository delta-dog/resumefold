    \lccode`\~`#1\lowercase{\endgroup\def~}{#2}}
\def\set@mathnolig#1{\ifnum\mathcode`#1<32768
   \begingroup\lccode`\~`#1\lowercase{\endgroup
     \edef~}{\mathchar\number\mathcode`#1\sb{\/}}%
   \mathcode`#1=32768 \fi}

