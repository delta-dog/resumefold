       \expandafter\NR@gettitle\expandafter{\inserttheoremaddition}%
      }{}%
      \@ifdefinable{\NRorg@beamer@descriptionitem}{%
        \let\NRorg@beamer@descriptionitem\beamer@descriptionitem
        \renewcommand{\beamer@descriptionitem}[1]{%
          \NR@gettitle{#1}%
