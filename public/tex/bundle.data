% \Url@acthash:    convert `other' (doubled) ## to active #
% \Url@actpercent: convert `other' % to active %
 \lccode`+=`\# \lccode`\~=`\#
  \lowercase {\long\gdef\Url@acthash{\Url@Edit\Url@String{++}{~}%
     \ifnum\mathcode`\#<32768 \def~{\#}\fi}}%
 \lccode`+=`\% \lccode`\~=`\%
