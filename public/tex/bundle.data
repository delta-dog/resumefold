  \Hy@boolkey{ocgcolorlinks}{#1}%
}
\Hy@AtBeginDocument{%
  \begingroup
    \@ifundefined{OBJ@OCG@view}{%
      \ifHy@ocgcolorlinks
        \Hy@Warning{%
          Driver does not support `ocgcolorlinks',\MessageBreak
          using `colorlinks' instead%
        }%
      \fi
    }{}%
  \endgroup
}
