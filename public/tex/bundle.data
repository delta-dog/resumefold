%%% -----------------------------------------------------------------------
%%% TRACKING/LETTERSPACING

\ifx\XeTeXrevision\@undefined
\SetTracking % pdftex/luatex
  [ name         = default,
    no ligatures = {f} ]
  { encoding     = {OT1,T1,T2A,LY1,OT4,QX,EU2,TU} }
  { }
\else
\SetTracking % xetex
  [ name         = default,
    features     = {ResetAll} ]
  { encoding     = {EU1,TU} }
  { }
\fi

