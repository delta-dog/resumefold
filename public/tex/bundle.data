      \def\Hy@driver{hluatex}%
      \PassOptionsToPackage{luatex}{color}%
    \fi
  \else
    \Hy@Error{%
      Wrong driver option `luatex',\MessageBreak
      because luaTeX in PDF mode is not detected%
    }\@ehc
  \fi
}
