            \MT@warning@nl{`#2' is not a valid prefix in inheritance list%
              \MessageBreak\MT@listname. Ignoring it}%
            \@secondoftwo}}}%
      {\def\@tempa{#3}%
       \def\MT@inh@prefix{#2}%
       \@gobble}%
      {\@firstofone}%
    }{\@firstofone}%
   {\let\MT@char\m@ne
    \let\MT@temp\@gobble
