  \DeclareDocumentCommand\Ref{s}
   {\IfBooleanTF{#1}{\@Refstar}{\T@Ref}}%
}
\DeclareHookRule{begindocument}{showkeys}{before}{nameref}
\def\T@nameref#1{%
  \NR@ref@showkeys{#1}%
